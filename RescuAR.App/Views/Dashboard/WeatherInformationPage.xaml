<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Dashboard"
    x:Class="RescuAR.App.Views.Dashboard.WeatherInformationPage"
    x:DataType="vm:WeatherInformationViewModel">

    <Border StrokeShape="RoundRectangle 16"
            StrokeThickness="1"
            Stroke="#E2E8F0"
            BackgroundColor="#FFFFFF"
            Padding="14"
            VerticalOptions="Fill">
        
        <!-- Allow tap gesture to request location permission and refresh real-time weather -->
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding RequestLocationAndRefreshCommand}" />
        </Border.GestureRecognizers>

        <VerticalStackLayout Spacing="6" VerticalOptions="Center">
            <!-- Location Line -->
            <Label Text="{Binding LocationName}"
                   TextColor="#64748B"
                   FontSize="11"
                   FontAttributes="Bold"
                   LineBreakMode="TailTruncation" />

            <!-- Temperature Display -->
            <Label Text="{Binding TemperatureDisplay}"
                   TextColor="#0F172A"
                   FontSize="26"
                   FontAttributes="Bold" />

            <!-- Weather Description -->
            <Label Text="{Binding ConditionDescription}"
                   TextColor="#0F172A"
                   FontSize="13"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap" />

            <!-- Weather Summary -->
            <Label Text="{Binding ConditionSummary}"
                   TextColor="#64748B"
                   FontSize="11"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </Border>
</ContentView>
