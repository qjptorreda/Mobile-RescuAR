<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Dashboard"
    x:Class="RescuAR.App.Views.Dashboard.WeatherInformationPage"
    x:DataType="vm:WeatherInformationViewModel">

    <VerticalStackLayout Spacing="8">
        <!-- Section Header -->
        <Label Text="Weather Forecast"
               TextColor="#000000"
               FontSize="14"
               FontAttributes="Bold" />

        <!-- Weather Card -->
        <Border StrokeShape="RoundRectangle 16"
                StrokeThickness="1"
                Stroke="#E5E5EA"
                BackgroundColor="#FFFFFF"
                Padding="20">
            
            <!-- Allow tap gesture to request location permission and refresh real-time weather -->
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding RequestLocationAndRefreshCommand}" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" VerticalOptions="Center">
                
                <!-- Weather Details -->
                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                    <!-- Location Line -->
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding LocationName}"
                               TextColor="#7F7F7F"
                               FontSize="13" />
                        <!-- Location Arrow symbol -->
                        <Path Data="M12 2L4.5 20.29L5.21 21L12 18L18.79 21L19.5 20.29L12 2Z"
                              Fill="#0A8491"
                              WidthRequest="12"
                              HeightRequest="12"
                              Aspect="Uniform"
                              VerticalOptions="Center">
                            <Path.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Path.RenderTransform>
                        </Path>
                    </HorizontalStackLayout>

                    <!-- Temperature -->
                    <Label Text="{Binding TemperatureDisplay}"
                           TextColor="#000000"
                           FontSize="38"
                           FontAttributes="Bold" />

                    <!-- Weather Description -->
                    <Label Text="{Binding ConditionDescription}"
                           TextColor="#000000"
                           FontSize="15"
                           FontAttributes="Bold" />

                    <!-- Weather Summary -->
                    <Label Text="{Binding ConditionSummary}"
                           TextColor="#7F7F7F"
                           FontSize="13" />
                </VerticalStackLayout>

                <!-- Weather Icon (SVG vector) -->
                <Path Grid.Column="1"
                      Data="{Binding IconPathData}"
                      Fill="#E5E5EA"
                      Stroke="#0A8491"
                      StrokeThickness="1.5"
                      WidthRequest="64"
                      HeightRequest="64"
                      Aspect="Uniform"
                      HorizontalOptions="Center"
                      VerticalOptions="Center" />
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
