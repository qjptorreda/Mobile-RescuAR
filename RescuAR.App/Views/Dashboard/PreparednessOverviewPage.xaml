<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Dashboard"
    x:Class="RescuAR.App.Views.Dashboard.PreparednessOverviewPage"
    x:DataType="vm:PreparednessOverviewViewModel">

    <Border StrokeShape="RoundRectangle 16"
            StrokeThickness="0"
            BackgroundColor="#D8F3DC"
            Padding="16"
            HeightRequest="150"
            VerticalOptions="Fill">

        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding NavigateToPreparationProgressCommand}" />
        </Border.GestureRecognizers>

        <Grid RowDefinitions="*,Auto" RowSpacing="8">
            <!-- Header & Subtitle -->
            <VerticalStackLayout Grid.Row="0" Spacing="6">
                <Label Text="{Binding Title}"
                       TextColor="#00875A"
                       FontSize="20"
                       FontAttributes="Bold" />
                <Label Text="{Binding Subtitle}"
                       TextColor="#2E7D32"
                       FontSize="12" />
            </VerticalStackLayout>

            <!-- Footer Link -->
            <HorizontalStackLayout Grid.Row="1" Spacing="4" VerticalOptions="End">
                <Label Text="{Binding ActionText}"
                       TextColor="#00875A"
                       FontSize="13"
                       FontAttributes="Bold" />
                <Path Data="M6.4,18L5,16.6L14.6,7H7V5H18V16H16V8.4L6.4,18Z"
                      Fill="#00875A"
                      WidthRequest="12"
                      HeightRequest="12"
                      Aspect="Uniform"
                      VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>
