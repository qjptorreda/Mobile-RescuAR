<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Dashboard"
    x:Class="RescuAR.App.Views.Dashboard.AreaStatusOverviewPage"
    x:DataType="vm:AreaStatusOverviewViewModel">

    <Border StrokeShape="RoundRectangle 16"
            StrokeThickness="0"
            BackgroundColor="{Binding BackgroundColor}"
            Padding="20"
            Margin="0,0,0,4">
        
        <Border.GestureRecognizers>
            <!-- Double-tap or long-press can cycle risk level for easy debugging/demoing -->
            <TapGestureRecognizer NumberOfTapsRequired="2" Command="{Binding CycleRiskLevelCommand}" />
        </Border.GestureRecognizers>

        <VerticalStackLayout Spacing="14">
            <!-- Header -->
            <Label Text="{Binding RiskTitle}"
                   TextColor="{Binding TextColor}"
                   FontSize="22"
                   FontAttributes="Bold" />

            <!-- Subtitle -->
            <Label Text="{Binding AdvisoriesText}"
                   TextColor="{Binding SubtitleColor}"
                   FontSize="13"
                   LineBreakMode="WordWrap" />

            <!-- Divider Line -->
            <BoxView HeightRequest="1" Color="{Binding SubtitleColor}" Opacity="0.15" Margin="0,4" />

            <!-- Details -->
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="12" ColumnSpacing="16">
                <!-- Nearest Center -->
                <Label Grid.Row="0" Grid.Column="0"
                       Text="Nearest Evacuation Center"
                       TextColor="{Binding LabelColor}"
                       FontSize="13"
                       VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Row="0" Grid.Column="1" HorizontalOptions="End" Spacing="4" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToEvacuationCenterCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="{Binding NearestCenterName}"
                           TextColor="{Binding LinkColor}"
                           FontAttributes="Bold"
                           FontSize="13" />
                    <Label Text=" ("
                           TextColor="{Binding LinkColor}"
                           FontSize="13" />
                    <Label Text="{Binding NearestCenterDistance}"
                           TextColor="{Binding LinkColor}"
                           FontAttributes="Bold"
                           FontSize="13" />
                    <Label Text=") >"
                           TextColor="{Binding LinkColor}"
                           FontSize="13" />
                </HorizontalStackLayout>

                <!-- Recommended Action -->
                <Label Grid.Row="1" Grid.Column="0"
                       Text="Recommended Action"
                       TextColor="{Binding LabelColor}"
                       FontSize="13"
                       VerticalOptions="Center" />
                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding RecommendedAction}"
                       TextColor="{Binding TextColor}"
                       FontAttributes="Bold"
                       FontSize="13"
                       HorizontalOptions="End"
                       VerticalOptions="Center" />

                <!-- Updated time -->
                <Label Grid.Row="2" Grid.Column="0"
                       Text="Updated at"
                       TextColor="{Binding LabelColor}"
                       FontSize="13"
                       VerticalOptions="Center" />
                <Label Grid.Row="2" Grid.Column="1"
                       Text="{Binding UpdatedText}"
                       TextColor="{Binding LabelColor}"
                       FontSize="13"
                       HorizontalOptions="End"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Divider Line -->
            <BoxView HeightRequest="1" Color="{Binding SubtitleColor}" Opacity="0.15" Margin="0,4" />

            <!-- Footer Link -->
            <HorizontalStackLayout Spacing="4" VerticalOptions="End">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewEmergencySummaryCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="View emergency summary >"
                       TextColor="{Binding LinkColor}"
                       FontSize="14"
                       FontAttributes="Bold" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
