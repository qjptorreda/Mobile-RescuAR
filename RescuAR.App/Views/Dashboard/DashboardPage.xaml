<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboard="clr-namespace:RescuAR.App.Views.Dashboard"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Dashboard"
    x:Class="RescuAR.App.Views.Dashboard.DashboardPage"
    x:DataType="vm:DashboardViewModel"
    Title="Home"
    BackgroundColor="#F2F2F7"
    Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="16">
            <!-- App Header -->
            <VerticalStackLayout Spacing="2" Margin="0,10,0,4">
                <Label Text="Home"
                       TextColor="#000000"
                       FontSize="32"
                       FontAttributes="Bold" />
                <Label Text="Everything you need in one place."
                       TextColor="#7F7F7F"
                       FontSize="14" />
            </VerticalStackLayout>

            <!-- Profile Greeting Card -->
            <Border StrokeShape="RoundRectangle 16"
                    StrokeThickness="1"
                    Stroke="#E5E5EA"
                    BackgroundColor="#FFFFFF"
                    Padding="16">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                    <!-- Profile Avatar icon container -->
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 24"
                            StrokeThickness="0"
                            BackgroundColor="#F2F2F7"
                            WidthRequest="48"
                            HeightRequest="48"
                            VerticalOptions="Center">
                        <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                              Fill="#0A8491"
                              WidthRequest="24"
                              HeightRequest="24"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Greeting}" TextColor="#7F7F7F" FontSize="13" />
                        <Label Text="{Binding UserName}" TextColor="#000000" FontSize="20" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Moderate Flood Risk Card -->
            <dashboard:AreaStatusOverviewPage />

            <!-- Quick Actions Section -->
            <dashboard:QuickActionsPage />

            <!-- Weather Forecast Card -->
            <dashboard:WeatherInformationPage />

            <!-- Modules Grid Section -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Modules"
                       TextColor="#000000"
                       FontSize="16"
                       FontAttributes="Bold" />
                
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <!-- Row 1 -->
                    <dashboard:DisasterInformationPage Grid.Row="0" Grid.Column="0" />
                    <dashboard:AdvisoriesActivePage Grid.Row="0" Grid.Column="1" />

                    <!-- Row 2 -->
                    <dashboard:PreparednessOverviewPage Grid.Row="1" Grid.Column="0" />
                    <dashboard:EvacuationOverviewPage Grid.Row="1" Grid.Column="1" />

                    <!-- Row 3 -->
                    <dashboard:SafetyCircleOverviewPage Grid.Row="2" Grid.Column="0" />
                    <dashboard:CommunityReportsOverviewPage Grid.Row="2" Grid.Column="1" />
                </Grid>
            </VerticalStackLayout>

            <!-- Preparation Assessment Card -->
            <dashboard:PASSOverviewPage />
        </VerticalStackLayout>
        </ScrollView>
        <!-- Subtle shadow/line for TabBar -->
        <BoxView VerticalOptions="End" HeightRequest="1" BackgroundColor="#D1D1D6" />
    </Grid>
</ContentPage>
