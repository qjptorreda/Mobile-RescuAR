<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboard="clr-namespace:RescuAR.App.Views.Dashboard"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Dashboard"
    x:Class="RescuAR.App.Views.Dashboard.DashboardPage"
    x:DataType="vm:DashboardViewModel"
    Title="Home"
    BackgroundColor="#F8FAFC"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            
            <!-- Bento Box Grid Section -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="12">
                
                <!-- Bento Tile 1: Top Hero User Greeting Banner (Span 2 Columns) -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#0A8491" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Greeting}" TextColor="#E0F2FE" FontSize="13" FontAttributes="Bold" />
                                <Label Text="{Binding UserName}" TextColor="#FFFFFF" FontSize="26" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <!-- Profile Avatar Badge -->
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 22" StrokeThickness="1.5" Stroke="#E0F2FE" BackgroundColor="#14B8A6" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="USER" TextColor="#FFFFFF" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <!-- Emergency Status Banner inside Hero -->
                        <Border BackgroundColor="#0F766E" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Text="Marikina River: Level 1 (Standby)" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                <Border Grid.Column="1" BackgroundColor="#22C55E" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,4" VerticalOptions="Center">
                                    <Label Text="Monitoring" TextColor="#FFFFFF" FontSize="10" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Bento Tile 2: PASS Preparedness Score Card (Span 2 Columns, No Text Overlap!) -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#FFFFFF" StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" Padding="18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenPASSCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                        
                        <!-- Left Details Column -->
                        <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="PASS Preparedness" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                            
                            <Border BackgroundColor="#E0F2FE" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,3" HorizontalOptions="Start">
                                <Label Text="{Binding PreparednessStatus}" TextColor="#0369A1" FontSize="11" FontAttributes="Bold" />
                            </Border>

                            <ProgressBar Progress="{Binding ScoreProgress}" ProgressColor="#0A8491" HeightRequest="8" Margin="0,4,0,0" />
                        </VerticalStackLayout>

                        <!-- Right Clean Percentage Score -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                            <Label Text="{Binding PreparednessScore, StringFormat='{0}%'}" TextColor="#0A8491" FontSize="34" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Bento Tile 3: Quick Action - Kit Checklist (Col 0) -->
                <Border Grid.Row="2" Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenChecklistCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Border BackgroundColor="#F0FDFA" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2" HorizontalOptions="Start">
                            <Label Text="CHECKLIST" TextColor="#0D9488" FontSize="10" FontAttributes="Bold" />
                        </Border>
                        <Label Text="Kit Checklist" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" Margin="0,4,0,0" />
                        <Label Text="10 Essential Supplies" TextColor="#64748B" FontSize="11" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Bento Tile 4: Quick Action - Evacuation Centers (Col 1) -->
                <Border Grid.Row="2" Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="16">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenEvacuationCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Border BackgroundColor="#EFF6FF" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="6,2" HorizontalOptions="Start">
                            <Label Text="SHELTERS" TextColor="#2563EB" FontSize="10" FontAttributes="Bold" />
                        </Border>
                        <Label Text="Evacuation Centers" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" Margin="0,4,0,0" />
                        <Label Text="Real-Time Capacity" TextColor="#64748B" FontSize="11" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Bento Tile 5: Area Status Overview Card (Span 2 Columns) -->
                <ContentView Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                    <dashboard:AreaStatusOverviewPage />
                </ContentView>

                <!-- Bento Tile 6: Weather Card (Col 0) -->
                <ContentView Grid.Row="4" Grid.Column="0">
                    <dashboard:WeatherInformationPage />
                </ContentView>

                <!-- Bento Tile 7: Preparedness Overview Card (Col 1) -->
                <ContentView Grid.Row="4" Grid.Column="1">
                    <dashboard:PreparednessOverviewPage />
                </ContentView>

            </Grid>

            <!-- Bottom PASS Widget -->
            <dashboard:PASSOverviewPage />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
