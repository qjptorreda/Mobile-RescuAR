<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Reports"
    x:Class="RescuAR.App.Views.Reports.CommunityPostingPage"
    x:Name="thisPage"
    Title="Community Feed &amp; Reports"
    BackgroundColor="#F8FAFC">

    <ContentPage.BindingContext>
        <vm:CommunityPostingViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <!-- Main Feed ScrollView -->
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Header & Broadcast Button -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Home / Reports" TextColor="#64748B" FontSize="12" FontAttributes="Bold" />
                        <Label Text="Community Feed" TextColor="#0F172A" FontSize="28" FontAttributes="Bold" />
                        <Label Text="Real-time disaster reports &amp; community updates." TextColor="#475569" FontSize="14" />
                    </VerticalStackLayout>
                    
                    <Button Grid.Column="1" Text="+ Post Report" TextColor="#FFFFFF" BackgroundColor="#0A8491" CornerRadius="12" HeightRequest="44" FontSize="13" FontAttributes="Bold" Padding="14,0" VerticalOptions="Center"
                            Command="{Binding ToggleCreatePostModalCommand}" />
                </Grid>

                <!-- Filter / Live Banner -->
                <Border BackgroundColor="#E0F2FE" Stroke="#BAE6FD" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Label Text="📡" FontSize="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Real-Time Sync Active" TextColor="#0369A1" FontSize="13" FontAttributes="Bold" />
                            <Label Text="Receiving live community hazard reports" TextColor="#0284C7" FontSize="11" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" WidthRequest="10" HeightRequest="10" StrokeShape="RoundRectangle 5" BackgroundColor="#22C55E" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Posts Stack -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Posts}" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CommunityPostItem">
                            <Border StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" BackgroundColor="#FFFFFF">
                                <VerticalStackLayout Spacing="14" Padding="16">
                                    
                                    <!-- Author & Timestamp -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                        <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="#F1F5F9">
                                            <Label Text="👤" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding AuthorName}" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                            <Label Text="{Binding Location, StringFormat='📍 {0}'}" TextColor="#64748B" FontSize="11" />
                                        </VerticalStackLayout>
                                        
                                        <Border Grid.Column="2" BackgroundColor="{Binding SeverityBg}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                            <Label Text="{Binding HazardSeverity}" TextColor="{Binding SeverityTextColor}" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>

                                    <!-- Post Content -->
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Title}" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="{Binding Content}" TextColor="#334155" FontSize="13" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>

                                    <!-- Attached Image Thumbnail (if present) -->
                                    <Border IsVisible="{Binding HasImage}" StrokeShape="RoundRectangle 12" StrokeThickness="0" HeightRequest="180" BackgroundColor="#F1F5F9">
                                        <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                                    </Border>

                                    <!-- Footer Actions -->
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,4,0,0">
                                        <Label Text="{Binding TimestampText}" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center" />

                                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                            <Button Text="{Binding Upvotes, StringFormat='👍 {0}'}" TextColor="#0F172A" BackgroundColor="#F1F5F9" CornerRadius="10" HeightRequest="36" FontSize="12" FontAttributes="Bold" Padding="12,0"
                                                    Command="{Binding BindingContext.ToggleUpvoteCommand, Source={x:Reference thisPage}}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Create Post Modal Overlay -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsCreatingPost}">
            <ScrollView VerticalOptions="Center" Margin="20">
                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20">
                    <VerticalStackLayout Spacing="16">
                        
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Publish Hazard Report" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="✕" TextColor="#64748B" FontSize="18" FontAttributes="Bold" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleCreatePostModalCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <Entry Placeholder="Title (e.g. Rising flood along JP Rizal)" Text="{Binding NewPostTitle}" FontSize="14" />
                        <Entry Placeholder="Location (e.g. Barangay Malanday)" Text="{Binding NewPostLocation}" FontSize="14" />
                        <Editor Placeholder="Detailed description of hazard or update..." Text="{Binding NewPostContent}" HeightRequest="90" FontSize="14" />

                        <!-- Severity Choice Pills -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Hazard Severity Level" TextColor="#64748B" FontSize="12" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Low" TextColor="#15803D" BackgroundColor="#DCFCE7" CornerRadius="8" HeightRequest="34" FontSize="12" FontAttributes="Bold" Padding="12,0"
                                        Command="{Binding SelectSeverityCommand}" CommandParameter="Low" />
                                <Button Text="Moderate" TextColor="#B45309" BackgroundColor="#FEF3C7" CornerRadius="8" HeightRequest="34" FontSize="12" FontAttributes="Bold" Padding="12,0"
                                        Command="{Binding SelectSeverityCommand}" CommandParameter="Moderate" />
                                <Button Text="High" TextColor="#C2410C" BackgroundColor="#FFEDD5" CornerRadius="8" HeightRequest="34" FontSize="12" FontAttributes="Bold" Padding="12,0"
                                        Command="{Binding SelectSeverityCommand}" CommandParameter="High" />
                                <Button Text="Severe" TextColor="#B91C1C" BackgroundColor="#FEE2E2" CornerRadius="8" HeightRequest="34" FontSize="12" FontAttributes="Bold" Padding="12,0"
                                        Command="{Binding SelectSeverityCommand}" CommandParameter="Severe" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Attached Photo Section -->
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Attach Evidence Photo" TextColor="#64748B" FontSize="12" FontAttributes="Bold" />
                            
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="📷 Take Photo" TextColor="#0F172A" BackgroundColor="#F1F5F9" CornerRadius="10" HeightRequest="40" FontSize="12" FontAttributes="Bold"
                                        Command="{Binding CapturePhotoCommand}" />
                                <Button Grid.Column="1" Text="🖼️ Choose Image" TextColor="#0F172A" BackgroundColor="#F1F5F9" CornerRadius="10" HeightRequest="40" FontSize="12" FontAttributes="Bold"
                                        Command="{Binding PickImageCommand}" />
                            </Grid>

                            <!-- Image Preview Box -->
                            <Grid IsVisible="{Binding HasAttachedImage}" HeightRequest="140">
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#F1F5F9">
                                    <Image Source="{Binding AttachedImagePath}" Aspect="AspectFill" />
                                </Border>
                                <Button Text="✕ Remove" TextColor="#FFFFFF" BackgroundColor="#CC000000" CornerRadius="8" HeightRequest="30" FontSize="11" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Start" Margin="8" Padding="8,0"
                                        Command="{Binding RemoveAttachedImageCommand}" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Submit Button -->
                        <Button Text="🚀 Broadcast Report Now" TextColor="#FFFFFF" BackgroundColor="#0A8491" CornerRadius="12" HeightRequest="48" FontSize="15" FontAttributes="Bold"
                                Command="{Binding CreatePostCommand}" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

    </Grid>
</ContentPage>