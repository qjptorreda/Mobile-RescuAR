<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Reports"
    xmlns:models="clr-namespace:RescuAR.App.Models"
    x:Class="RescuAR.App.Views.Reports.AdvisoryFeedPage"
    x:DataType="vm:AdvisoryFeedViewModel"
    Title="Updates"
    BackgroundColor="#F2F2F7"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <!-- Top App Bar -->
        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                StrokeThickness="0"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <!-- Back Button -->
                <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                          Fill="#000000"
                          WidthRequest="16"
                          HeightRequest="16"
                          Aspect="Uniform"
                          VerticalOptions="Center" />
                    <Label Text="Back"
                           TextColor="#000000"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- App Title -->
                <Label Grid.Column="1"
                       Text="RescuAR"
                       TextColor="#000000"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <!-- Bell Icon -->
                <Border Grid.Column="2"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        Padding="4"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M12,2A2,2 0 0,0 10,4A7,7 0 0,0 3,11V16L1,18V19H23V18L21,16V11A7,7 0 0,0 14,4A2,2 0 0,0 12,2M10,20A2,2 0 0,0 12,22A2,2 0 0,0 14,20H10Z"
                          Fill="#000000"
                          WidthRequest="22"
                          HeightRequest="22"
                          Aspect="Uniform"
                          VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Scrollable Body Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="16">

                <!-- Title & Header Section -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Home/" TextColor="#7F7F7F" FontSize="13" />
                    <Label Text="Updates" TextColor="#000000" FontSize="32" FontAttributes="Bold" />
                    <Label Text="Verified disaster alerts and advisories." TextColor="#7F7F7F" FontSize="15" />
                </VerticalStackLayout>

                <!-- Active Monitoring Card -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        BackgroundColor="#FFFFFF"
                        Padding="16">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Border StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#D1F4E2"
                                    Padding="8,4"
                                    HorizontalOptions="Start"
                                    StrokeThickness="0">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Ellipse WidthRequest="6" HeightRequest="6" Fill="#1B7F4B" VerticalOptions="Center" />
                                    <Label Text="Active Monitoring" TextColor="#1B7F4B" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Label Text="Within 5 km of your location." TextColor="#000000" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding LastUpdatedText}" TextColor="#999999" FontSize="12" />
                        </VerticalStackLayout>

                        <!-- Signal Waves Icon -->
                        <Path Grid.Column="1"
                              Data="M12,11A1,1 0 0,0 11,12A1,1 0 0,0 12,13A1,1 0 0,0 13,12A1,1 0 0,0 12,11M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21A9,9 0 0,0 21,12A9,9 0 0,0 12,3Z"
                              Fill="#E5E5EA"
                              WidthRequest="48"
                              HeightRequest="48"
                              Aspect="Uniform"
                              VerticalOptions="Center"
                              HorizontalOptions="End" />
                    </Grid>
                </Border>

                <!-- Categories Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Categories" TextColor="#7F7F7F" FontSize="13" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding CategoryChips}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryChipItem">
                                    <Border StrokeShape="RoundRectangle 10"
                                            StrokeThickness="1"
                                            Stroke="{Binding BorderColor}"
                                            BackgroundColor="{Binding BgColor}"
                                            Padding="16,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdvisoryFeedViewModel}}, Path=SelectCategoryCommand}"
                                                CommandParameter="{Binding Name}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Name}" TextColor="{Binding TextColor}" FontSize="13" FontAttributes="Bold" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Status Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Status" TextColor="#7F7F7F" FontSize="13" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding StatusChips}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryChipItem">
                                    <Border StrokeShape="RoundRectangle 10"
                                            StrokeThickness="1"
                                            Stroke="{Binding BorderColor}"
                                            BackgroundColor="{Binding BgColor}"
                                            Padding="16,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdvisoryFeedViewModel}}, Path=SelectStatusCommand}"
                                                CommandParameter="{Binding Name}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Name}" TextColor="{Binding TextColor}" FontSize="13" FontAttributes="Bold" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Advisory Feed List -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding DisplayedAdvisories}" Spacing="14">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:DisasterAdvisory">
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="1"
                                    Stroke="#E5E5EA"
                                    BackgroundColor="#FFFFFF"
                                    Padding="16">
                                <VerticalStackLayout Spacing="12">
                                    <!-- Badges Row -->
                                    <HorizontalStackLayout Spacing="6">
                                        <!-- Severity Pill -->
                                        <Border StrokeShape="RoundRectangle 6" BackgroundColor="{Binding SeverityBgColor}" Padding="8,4" StrokeThickness="0">
                                            <Label Text="{Binding Severity}" TextColor="{Binding SeverityTextColor}" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                        <!-- Category Pill -->
                                        <Border StrokeShape="RoundRectangle 6" BackgroundColor="#FFFFFF" Stroke="#E5E5EA" StrokeThickness="1" Padding="8,4">
                                            <Label Text="{Binding Category}" TextColor="#000000" FontSize="11" />
                                        </Border>
                                        <!-- Type Tag Pill -->
                                        <Border StrokeShape="RoundRectangle 6" BackgroundColor="#FFFFFF" Stroke="#E5E5EA" StrokeThickness="1" Padding="8,4">
                                            <Label Text="{Binding TypeTag}" TextColor="#000000" FontSize="11" />
                                        </Border>
                                        <!-- Status Pill -->
                                        <Border StrokeShape="RoundRectangle 6" BackgroundColor="{Binding StatusBgColor}" Padding="8,4" StrokeThickness="0">
                                            <Label Text="{Binding Status}" TextColor="{Binding StatusTextColor}" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Main Title -->
                                    <Label Text="{Binding Title}" TextColor="#000000" FontSize="18" FontAttributes="Bold" LineBreakMode="WordWrap" />

                                    <!-- Description (if present) -->
                                    <Label Text="{Binding Description}"
                                           TextColor="#555555"
                                           FontSize="13"
                                           IsVisible="{Binding HasDescription}"
                                           LineBreakMode="WordWrap" />

                                    <!-- Key-Value Details Grid -->
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="6">
                                        <Label Grid.Row="0" Grid.Column="0" Text="Affected Area" TextColor="#999999" FontSize="13" />
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding AffectedArea}" TextColor="#000000" FontSize="13" FontAttributes="Bold" HorizontalOptions="End" />

                                        <Label Grid.Row="1" Grid.Column="0" Text="Issued by" TextColor="#999999" FontSize="13" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding IssuedBy}" TextColor="#000000" FontSize="13" HorizontalOptions="End" />

                                        <Label Grid.Row="2" Grid.Column="0" Text="Issued at" TextColor="#999999" FontSize="13" />
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding FormattedIssuedAt}" TextColor="#000000" FontSize="13" HorizontalOptions="End" />
                                    </Grid>

                                    <!-- View Details Link -->
                                    <HorizontalStackLayout Spacing="4" Margin="0,4,0,0">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdvisoryFeedViewModel}}, Path=ViewDetailsCommand}"
                                                CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Label Text="View details" TextColor="#0A8491" FontSize="14" FontAttributes="Bold" />
                                        <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                              Fill="#0A8491"
                                              WidthRequest="14"
                                              HeightRequest="14"
                                              Aspect="Uniform"
                                              VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Footer note -->
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,8,0,16">
                    <Ellipse WidthRequest="6" HeightRequest="6" Fill="#1B7F4B" VerticalOptions="Center" />
                    <Label Text="Alerts are updating in real time." TextColor="#7F7F7F" FontSize="12" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
