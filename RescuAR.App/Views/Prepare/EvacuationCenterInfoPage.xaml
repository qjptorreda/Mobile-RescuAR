<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Prepare"
    x:Class="RescuAR.App.Views.Prepare.EvacuationCenterInfoPage"
    x:Name="thisPage"
    Title="Evacuation &amp; Contacts"
    BackgroundColor="#F8FAFC">

    <ContentPage.BindingContext>
        <vm:EvacuationCenterInfoViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">
            
            <!-- Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Home / Emergency" TextColor="#64748B" FontSize="12" FontAttributes="Bold" />
                <Label Text="Evacuation &amp; Hotlines" TextColor="#0F172A" FontSize="28" FontAttributes="Bold" />
                <Label Text="Real-time capacity tracking &amp; emergency contacts." TextColor="#475569" FontSize="14" />
            </VerticalStackLayout>

            <!-- Section 1: Hotlines -->
            <VerticalStackLayout Spacing="14">
                <Label Text="Emergency Hotlines" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Hotlines}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:EmergencyHotlineItem">
                            <Border StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFFFF" Padding="14">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                                    
                                    <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="0" BackgroundColor="#E0F2FE">
                                        <Label Text="{Binding BadgeText}" TextColor="#0369A1" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                                        <Label Text="{Binding Number}" TextColor="#0A8491" FontSize="13" FontAttributes="Bold" />
                                        <Label Text="{Binding Type}" TextColor="#64748B" FontSize="11" />
                                    </VerticalStackLayout>
                                    
                                    <Button Grid.Column="2" Text="Call" TextColor="#FFFFFF" BackgroundColor="#0A8491" CornerRadius="10" HeightRequest="38" FontSize="12" FontAttributes="Bold" Padding="14,0"
                                            Command="{Binding BindingContext.DialNumberAsyncCommand, Source={x:Reference thisPage}}"
                                            CommandParameter="{Binding Number}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Section 2: Evacuation Centers Near You -->
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Evacuation Centers (Real-time)" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Open Map" TextColor="#0A8491" BackgroundColor="#E0F2FE" CornerRadius="10" HeightRequest="36" FontSize="12" FontAttributes="Bold" Padding="12,0"
                            Command="{Binding NavigateToMapCommand}" />
                </Grid>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding EvacuationCenters}" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:EvacuationCenterItem">
                            <Border StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" BackgroundColor="#FFFFFF">
                                <VerticalStackLayout Spacing="14" Padding="16">
                                    
                                    <!-- Header Row -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" />
                                            <Label Text="{Binding Distance}" TextColor="#0A8491" FontSize="13" FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="{Binding StatusPillBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,4">
                                            <Label Text="{Binding StatusLabel}" TextColor="{Binding StatusPillText}" FontSize="12" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>

                                    <!-- Address -->
                                    <Label Text="{Binding Address, StringFormat='Address: {0}'}" TextColor="#475569" FontSize="12" />

                                    <!-- Real-time Capacity Progress Bar -->
                                    <VerticalStackLayout Spacing="6" BackgroundColor="#F8FAFC" Padding="12" RoundRectangle.CornerRadius="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="Capacity Occupancy" TextColor="#64748B" FontSize="12" FontAttributes="Bold" />
                                            <Label Grid.Column="1" Text="{Binding CapacityText}" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" />
                                        </Grid>
                                        <ProgressBar Progress="{Binding ProgressValue}" ProgressColor="#0A8491" HeightRequest="8" />
                                    </VerticalStackLayout>

                                    <!-- Action Row -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding VerifiedBy, StringFormat='Verified by {0}'}" TextColor="#16A34A" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="Live Check-In" TextColor="#FFFFFF" BackgroundColor="#0A8491" CornerRadius="10" HeightRequest="38" FontSize="12" FontAttributes="Bold" Padding="14,0"
                                                Command="{Binding BindingContext.CheckInEvacueeCommand, Source={x:Reference thisPage}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>