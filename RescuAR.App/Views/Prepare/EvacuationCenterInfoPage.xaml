<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Prepare"
    x:Class="RescuAR.App.Views.Prepare.EvacuationCenterInfoPage"
    x:Name="thisPage"
    Title="Evacuation &amp; Contacts"
    BackgroundColor="#F2F2F7">

    <ContentPage.BindingContext>
        <vm:EvacuationCenterInfoViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">
            
            <!-- Section 1: Emergency Hotlines -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Emergency Hotlines" TextColor="#000000" FontSize="18" FontAttributes="Bold" />
                
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#FFFFFF">
                    <VerticalStackLayout Padding="12" Spacing="0">
                        <BindableLayout.ItemsSource>
                            <Binding Path="Hotlines" />
                        </BindableLayout.ItemsSource>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:EmergencyHotlineItem">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,12" ColumnSpacing="12" VerticalOptions="Center">
                                        <!-- Phone Outline Icon Container -->
                                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#E8F4F8" WidthRequest="40" HeightRequest="40">
                                            <Path Data="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z"
                                                  Fill="#0A8491" WidthRequest="20" HeightRequest="20" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        
                                        <!-- Hotline Details -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" TextColor="#000000" FontSize="14" FontAttributes="Bold" />
                                            <Label Text="{Binding Number}" TextColor="#000000" FontSize="12" />
                                            <Label Text="{Binding Type}" TextColor="#7F7F7F" FontSize="10" />
                                        </VerticalStackLayout>
                                        
                                        <!-- Call Button -->
                                        <Button Grid.Column="2" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#F2F2F7" Padding="0"
                                                Command="{Binding BindingContext.DialNumberCommand, Source={x:Reference thisPage}}"
                                                CommandParameter="{Binding Number}">
                                            <Button.ImageSource>
                                                <FontImageSource Glyph="📞" Color="Black" Size="16" />
                                            </Button.ImageSource>
                                        </Button>
                                    </Grid>
                                    <!-- Divider -->
                                    <BoxView HeightRequest="1" Color="#F2F2F7" Margin="8,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Section 2: Evacuation Centers Near You -->
            <VerticalStackLayout Spacing="16">
                <Label Text="Evacuation Centers Near You" TextColor="#000000" FontSize="18" FontAttributes="Bold" />
                
                <!-- Filter Tabs -->
                <HorizontalStackLayout Spacing="12">
                    <Border BackgroundColor="#0A8491" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,6">
                        <Label Text="Nearest" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold" />
                    </Border>
                    <Border BackgroundColor="#E2E2E2" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,6">
                        <Label Text="Within 1 km" TextColor="#7F7F7F" FontSize="12" FontAttributes="Bold" />
                    </Border>
                </HorizontalStackLayout>

                <!-- Evacuation Center Cards -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding EvacuationCenters}" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:EvacuationCenterItem">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF">
                                <VerticalStackLayout Spacing="12" Padding="16">
                                    
                                    <!-- Dynamic School/Center Photo Placeholder -->
                                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" HeightRequest="120" BackgroundColor="#E2E2E2">
                                        <Grid>
                                            <Label Text="🏢 School Evacuation Facility" TextColor="#7F7F7F" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                    
                                    <Label Text="{Binding Name}" TextColor="#000000" FontSize="16" FontAttributes="Bold" />
                                    <Label Text="{Binding Distance}" TextColor="#0A8491" FontSize="13" FontAttributes="Bold" />
                                    
                                    <!-- Info Grid -->
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8">
                                        <Label Grid.Row="0" Grid.Column="0" Text="Address:" TextColor="#7F7F7F" FontSize="12" />
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Address}" TextColor="#000000" FontSize="12" LineBreakMode="WordWrap" />
                                        
                                        <Label Grid.Row="1" Grid.Column="0" Text="Verified by:" TextColor="#7F7F7F" FontSize="12" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding VerifiedBy}" TextColor="#22C55E" FontSize="12" FontAttributes="Bold" />
                                    </Grid>

                                    <!-- Bottom Chevron Action -->
                                    <HorizontalStackLayout HorizontalOptions="Start" Spacing="4" Margin="0,4,0,0">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding BindingContext.NavigateToMapCommand, Source={x:Reference thisPage}}" />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        <Label Text="View more details" TextColor="#0A8491" FontSize="13" FontAttributes="Bold" />
                                        <Label Text="&gt;" TextColor="#0A8491" FontSize="13" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>