<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Prepare"
    x:Class="RescuAR.App.Views.Prepare.PASSPage"
    Title="Preparation Assessment"
    BackgroundColor="#F2F2F7">

    <ContentPage.BindingContext>
        <vm:PASSViewModel />
    </ContentPage.BindingContext>

    <!-- Use Grid to support the modal overlay -->
    <Grid>
        
        <!-- Main Scrollable Content -->
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="24">

                <!-- Header Section -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Home/" TextColor="#7F7F7F" FontSize="12" />
                    <Label Text="Preparation Assessment" TextColor="#000000" FontSize="26" FontAttributes="Bold" />
                    <Label Text="Evaluate your overall preparedness for emergencies and evacuation." TextColor="#7F7F7F" FontSize="14" />
                </VerticalStackLayout>

                <!-- Score Card -->
                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Padding="16" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Preparedness Score" TextColor="#7F7F7F" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border Grid.Column="1" BackgroundColor="#E2F0D9" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,4">
                                <Label Text="Prepared" TextColor="#385723" FontSize="10" FontAttributes="Bold" />
                            </Border>
                        </Grid>

                        <Label Text="72% prepared" TextColor="#0F8068" FontSize="28" FontAttributes="Bold" />

                        <ProgressBar Progress="0.72" ProgressColor="#0F8068" HeightRequest="8" />

                        <Label Text="You have completed most recommended preparedness activities but should address remaining readiness gaps." TextColor="#000000" FontSize="13" />
                        <Label Text="Last assessed June 15, 2026" TextColor="#7F7F7F" FontSize="11" />

                        <!-- Retake Link -->
                        <HorizontalStackLayout HorizontalOptions="Start" Spacing="4" Margin="0,4,0,0">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleModalCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label Text="Retake assessment" TextColor="#0F8068" FontSize="14" FontAttributes="Bold" />
                            <Label Text=" &gt;" TextColor="#0F8068" FontSize="14" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Section: Assessment Breakdown -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Assessment Breakdown" TextColor="#000000" FontSize="16" FontAttributes="Bold" />

                    <!-- Accordion 1: Emergency Supplies -->
                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#FFFFFF" Margin="0,0,0,8">
                        <VerticalStackLayout>
                            <!-- Header -->
                            <Grid ColumnDefinitions="*,Auto" Padding="16" BackgroundColor="#FFFFFF">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleEmergencySuppliesCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Emergency Supplies (85%)" TextColor="#000000" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="▲" TextColor="#7F7F7F" FontSize="14" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsEmergencySuppliesExpanded}" Value="False">
                                            <Setter Property="Text" Value="▼" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                            
                            <!-- Content Items -->
                            <VerticalStackLayout Padding="16,0,16,16" Spacing="10" IsVisible="{Binding IsEmergencySuppliesExpanded}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✓" TextColor="#22C55E" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="Water Supply" TextColor="#000000" FontSize="13" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✓" TextColor="#22C55E" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="First Aid Kit" TextColor="#000000" FontSize="13" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✓" TextColor="#22C55E" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="Flashlight" TextColor="#000000" FontSize="13" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✗" TextColor="#EF4444" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="Portable Radio" TextColor="#000000" FontSize="13" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Accordion 2: Evacuation Readiness -->
                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#FFFFFF" Margin="0,0,0,8">
                        <VerticalStackLayout>
                            <!-- Header -->
                            <Grid ColumnDefinitions="*,Auto" Padding="16" BackgroundColor="#FFFFFF">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleEvacuationReadinessCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Evacuation Readiness (60%)" TextColor="#000000" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="▲" TextColor="#7F7F7F" FontSize="14" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsEvacuationReadinessExpanded}" Value="False">
                                            <Setter Property="Text" Value="▼" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <!-- Content Items -->
                            <VerticalStackLayout Padding="16,0,16,16" Spacing="10" IsVisible="{Binding IsEvacuationReadinessExpanded}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✓" TextColor="#22C55E" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="Nearest evacuation center known" TextColor="#000000" FontSize="13" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✓" TextColor="#22C55E" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="Practice route completed" TextColor="#000000" FontSize="13" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✗" TextColor="#EF4444" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="Household evacuation plan missing" TextColor="#000000" FontSize="13" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✗" TextColor="#EF4444" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="Family meeting point not defined" TextColor="#000000" FontSize="13" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Accordion 3: Emergency Communication -->
                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#FFFFFF" Margin="0,0,0,8">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" Padding="16" BackgroundColor="#FFFFFF">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleEmergencyCommunicationCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Emergency Communication (90%)" TextColor="#000000" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="▼" TextColor="#7F7F7F" FontSize="14" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsEmergencyCommunicationExpanded}" Value="True">
                                            <Setter Property="Text" Value="▲" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <VerticalStackLayout Padding="16,0,16,16" Spacing="10" IsVisible="{Binding IsEmergencyCommunicationExpanded}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✓" TextColor="#22C55E" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="Emergency contacts configured" TextColor="#000000" FontSize="13" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✓" TextColor="#22C55E" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="Local hotlines available" TextColor="#000000" FontSize="13" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✓" TextColor="#22C55E" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="Mobile device charged" TextColor="#000000" FontSize="13" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Accordion 4: Household Preparedness -->
                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#FFFFFF" Margin="0,0,0,8">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" Padding="16" BackgroundColor="#FFFFFF">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleHouseholdPreparednessCommand}" />
                                </Grid.GestureRecognizers>
                                <Label Text="Household Preparedness (55%)" TextColor="#000000" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="▼" TextColor="#7F7F7F" FontSize="14" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsHouseholdPreparednessExpanded}" Value="True">
                                            <Setter Property="Text" Value="▲" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <VerticalStackLayout Padding="16,0,16,16" Spacing="10" IsVisible="{Binding IsHouseholdPreparednessExpanded}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✓" TextColor="#22C55E" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="Family aware of emergency procedures" TextColor="#000000" FontSize="13" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✗" TextColor="#EF4444" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="Vulnerable members not accounted for" TextColor="#000000" FontSize="13" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="✗" TextColor="#EF4444" FontSize="16" FontAttributes="Bold" Margin="0,0,8,0" />
                                    <Label Grid.Column="1" Text="Emergency responsibilities undefined" TextColor="#000000" FontSize="13" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Section: Recommended Actions -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Recommendation Actions" TextColor="#000000" FontSize="16" FontAttributes="Bold" />

                    <!-- Action 1: Practice AR Route -->
                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#FFFFFF">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding StartARRouteCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="12" ColumnSpacing="12" VerticalOptions="Center">
                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#F2F2F7" WidthRequest="40" HeightRequest="40">
                                <Label Text="🕶️" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Practice AR Route" TextColor="#000000" FontSize="14" FontAttributes="Bold" />
                                <Label Text="Prepare / Preparedness Tools / AR Route Practice" TextColor="#7F7F7F" FontSize="10" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="&gt;" TextColor="#7F7F7F" FontSize="16" VerticalOptions="Center" Margin="0,0,4,0" />
                        </Grid>
                    </Border>

                    <!-- Action 2: Open Emergency Checklist -->
                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#FFFFFF">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToChecklistCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="12" ColumnSpacing="12" VerticalOptions="Center">
                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#F2F2F7" WidthRequest="40" HeightRequest="40">
                                <Label Text="📋" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Open Emergency Checklist" TextColor="#000000" FontSize="14" FontAttributes="Bold" />
                                <Label Text="Prepare / Emergency Kit Checklist" TextColor="#7F7F7F" FontSize="10" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="&gt;" TextColor="#7F7F7F" FontSize="16" VerticalOptions="Center" Margin="0,0,4,0" />
                        </Grid>
                    </Border>

                    <!-- Action 3: View Nearby Evacuation Centers -->
                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#FFFFFF">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToEvacuationCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="12" ColumnSpacing="12" VerticalOptions="Center">
                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#F2F2F7" WidthRequest="40" HeightRequest="40">
                                <Label Text="🏢" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="View Nearby Evacuation Centers" TextColor="#000000" FontSize="14" FontAttributes="Bold" />
                                <Label Text="Prepare / Evacuation Centers Near You" TextColor="#7F7F7F" FontSize="10" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="&gt;" TextColor="#7F7F7F" FontSize="16" VerticalOptions="Center" Margin="0,0,4,0" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Section: Assessment History -->
                <VerticalStackLayout Spacing="12" Margin="0,0,0,16">
                    <Label Text="Assessment History" TextColor="#000000" FontSize="16" FontAttributes="Bold" />

                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#FFFFFF">
                        <VerticalStackLayout Padding="12" Spacing="0" BindableLayout.ItemsSource="{Binding History}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AssessmentHistoryItem">
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="*,Auto" Padding="8,12" VerticalOptions="Center">
                                            <Label Text="{Binding Date}" TextColor="#000000" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="{Binding StatusColor}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                                <Label Text="{Binding Status}" TextColor="#FFFFFF" FontSize="10" FontAttributes="Bold" />
                                            </Border>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="#F2F2F7" Margin="8,0" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Sheet Overlay / Modal Popup (Image 3) -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsModalVisible}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleModalCommand}" />
            </Grid.GestureRecognizers>
            
            <!-- Bottom sheet card -->
            <Border VerticalOptions="End" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 16,16,0,0">
                <!-- Intercept taps on the sheet itself so they don't dismiss it -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                
                <VerticalStackLayout Padding="24" Spacing="20">
                    
                    <!-- Drag handle and Header -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Text="Preparation Assessment" TextColor="#000000" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="✕" FontSize="16" TextColor="#7F7F7F" BackgroundColor="Transparent" Padding="0" WidthRequest="32" HeightRequest="32"
                                Command="{Binding ToggleModalCommand}" />
                    </Grid>

                    <Label Text="Evaluate your overall preparedness for emergencies and evacuation." TextColor="#000000" FontSize="14" FontAttributes="Bold" />

                    <!-- Details Bullets -->
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="•" TextColor="#0F8068" FontSize="16" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Takes approximately 2–3 minutes" TextColor="#7F7F7F" FontSize="13" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="•" TextColor="#0F8068" FontSize="16" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="15 questions" TextColor="#7F7F7F" FontSize="13" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="•" TextColor="#0F8068" FontSize="16" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="Results are stored locally" TextColor="#7F7F7F" FontSize="13" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="•" TextColor="#0F8068" FontSize="16" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="You can retake the assessment anytime" TextColor="#7F7F7F" FontSize="13" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Start Button -->
                    <Button Text="▷ Start Assessment" TextColor="#FFFFFF" BackgroundColor="#0F8068" FontSize="15" FontAttributes="Bold" HeightRequest="50" CornerRadius="8"
                            Command="{Binding StartAssessmentCommand}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        
    </Grid>
</ContentPage>