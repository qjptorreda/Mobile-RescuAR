<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Prepare"
    x:Class="RescuAR.App.Views.Prepare.ChecklistPage"
    x:Name="thisPage"
    Title="Emergency Kit Checklist"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F8FAFC">

    <ContentPage.BindingContext>
        <vm:ChecklistViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Top Custom Header Bar -->
        <Border Grid.Row="0" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 16" WidthRequest="36" HeightRequest="36">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="←" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="Emergency Kit Checklist" TextColor="#0F172A" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Main Scrollable Area -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="20">
                
                <!-- 1. Preparedness Readiness Status Banner Card -->
                <Border BackgroundColor="#FFFFFF" StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 20" Padding="18">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="72-Hour Survival Readiness" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Essential supplies for emergency evacuation" TextColor="#64748B" FontSize="11" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="{Binding ReadinessStatusBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,4" VerticalOptions="Center">
                                <Label Text="{Binding ReadinessStatus}" TextColor="{Binding ReadinessStatusText}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                        
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                            <Border BackgroundColor="#F0FDFA" Stroke="#CCFBF1" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="12,8">
                                <Label Text="{Binding PercentReady, StringFormat='{0}%'}" TextColor="#0A8491" FontSize="32" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <ProgressBar Progress="{Binding ProgressValue}" ProgressColor="#0A8491" HeightRequest="10" />
                                <Label Text="{Binding PreparedCountText}" TextColor="#64748B" FontSize="12" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. Supply Categories Filters (No Add Item Button) -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Supply Categories" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" />

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <!-- Category: All -->
                            <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="14,8">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedCategory}" Value="All">
                                        <Setter Property="BackgroundColor" Value="#0A8491" />
                                        <Setter Property="Stroke" Value="#0A8491" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" CommandParameter="All" />
                                </Border.GestureRecognizers>
                                <Label Text="All Supplies" TextColor="#0F172A" FontSize="13" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedCategory}" Value="All">
                                            <Setter Property="TextColor" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!-- Category: Food & Water -->
                            <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="14,8">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedCategory}" Value="Food &amp; Water">
                                        <Setter Property="BackgroundColor" Value="#0A8491" />
                                        <Setter Property="Stroke" Value="#0A8491" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" CommandParameter="Food &amp; Water" />
                                </Border.GestureRecognizers>
                                <Label Text="Food &amp; Water" TextColor="#0F172A" FontSize="13" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedCategory}" Value="Food &amp; Water">
                                            <Setter Property="TextColor" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!-- Category: Medical & Safety -->
                            <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="14,8">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedCategory}" Value="Medical &amp; Safety">
                                        <Setter Property="BackgroundColor" Value="#0A8491" />
                                        <Setter Property="Stroke" Value="#0A8491" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" CommandParameter="Medical &amp; Safety" />
                                </Border.GestureRecognizers>
                                <Label Text="Medical &amp; Safety" TextColor="#0F172A" FontSize="13" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedCategory}" Value="Medical &amp; Safety">
                                            <Setter Property="TextColor" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!-- Category: Tools & Power -->
                            <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="14,8">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedCategory}" Value="Tools &amp; Power">
                                        <Setter Property="BackgroundColor" Value="#0A8491" />
                                        <Setter Property="Stroke" Value="#0A8491" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" CommandParameter="Tools &amp; Power" />
                                </Border.GestureRecognizers>
                                <Label Text="Tools &amp; Power" TextColor="#0F172A" FontSize="13" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedCategory}" Value="Tools &amp; Power">
                                            <Setter Property="TextColor" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!-- Category: Documents -->
                            <Border StrokeThickness="1" Stroke="#CBD5E1" StrokeShape="RoundRectangle 12" BackgroundColor="#FFFFFF" Padding="14,8">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding SelectedCategory}" Value="Documents">
                                        <Setter Property="BackgroundColor" Value="#0A8491" />
                                        <Setter Property="Stroke" Value="#0A8491" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCategoryCommand}" CommandParameter="Documents" />
                                </Border.GestureRecognizers>
                                <Label Text="Documents &amp; Cash" TextColor="#0F172A" FontSize="13" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding SelectedCategory}" Value="Documents">
                                            <Setter Property="TextColor" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- 3. Checklist Items List with Lucide Icons (No OK Text!) -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredItems}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChecklistItem">
                            <Border StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 16" BackgroundColor="#FFFFFF" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding BindingContext.ToggleItemCommand, Source={x:Reference thisPage}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    
                                    <!-- Lucide Icon Container -->
                                    <Border Grid.Column="0" BackgroundColor="{Binding IconBgColor}" StrokeThickness="0" StrokeShape="RoundRectangle 14" WidthRequest="46" HeightRequest="46" VerticalOptions="Center">
                                        <Path Data="{Binding IconGeometry}"
                                              Fill="{Binding IconFillBrush}"
                                              WidthRequest="22" HeightRequest="22"
                                              Aspect="Uniform"
                                              HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <!-- Title, Priority Tag, and Description -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter Property="TextColor" Value="#94A3B8" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            
                                            <!-- Priority Tag Pill -->
                                            <Border BackgroundColor="{Binding TagBgColor}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,2" VerticalOptions="Center">
                                                <Label Text="{Binding PriorityTag}" TextColor="{Binding TagColor}" FontSize="9" FontAttributes="Bold" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding Description}" TextColor="#64748B" FontSize="12" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>

                                    <!-- Checkmark Circle (Lucide SVG Checkmark - NO OK TEXT!) -->
                                    <Border Grid.Column="2" WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14" StrokeThickness="1.5" Stroke="#CBD5E1" BackgroundColor="Transparent" VerticalOptions="Center">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#16A34A" />
                                                <Setter Property="Stroke" Value="#16A34A" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        
                                        <!-- SVG Checkmark Icon (Only visible when completed) -->
                                        <Path Data="M20 6L9 17l-5-5"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="2.5"
                                              StrokeLineCap="Round"
                                              StrokeLineJoin="Round"
                                              WidthRequest="14" HeightRequest="14"
                                              Aspect="Uniform"
                                              HorizontalOptions="Center" VerticalOptions="Center"
                                              IsVisible="{Binding IsCompleted}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Add Custom Item Modal Overlay -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsAddModalVisible}">
            <Border BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 18" Margin="24" Padding="20" VerticalOptions="Center">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Add Custom Kit Item" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                    
                    <Entry Placeholder="Item Title (e.g., Heavy Duty Gloves)" Text="{Binding NewItemTitle}" FontSize="14" />
                    <Entry Placeholder="Item Description (e.g., Protection from sharp debris)" Text="{Binding NewItemDescription}" FontSize="14" />

                    <!-- Category Selection Dropdown -->
                    <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,0" BackgroundColor="#FFFFFF">
                        <Grid ColumnDefinitions="*,Auto">
                            <Picker Grid.Column="0"
                                    Title="Select Category"
                                    TitleColor="#94A3B8"
                                    TextColor="#0F172A"
                                    FontSize="14"
                                    ItemsSource="{Binding AvailableCategories}"
                                    SelectedItem="{Binding NewItemCategory}"
                                    VerticalOptions="Center" />
                            <Path Grid.Column="1"
                                  Data="M7,10L12,15L17,10H7Z"
                                  Fill="#64748B"
                                  WidthRequest="12"
                                  HeightRequest="12"
                                  Aspect="Uniform"
                                  HorizontalOptions="End"
                                  VerticalOptions="Center"
                                  InputTransparent="True" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Text="Cancel" TextColor="#64748B" BackgroundColor="#F1F5F9" CornerRadius="10" HeightRequest="44" FontSize="14" FontAttributes="Bold"
                                Command="{Binding CloseAddModalCommand}" />
                        <Button Grid.Column="1" Text="Save Item" TextColor="#FFFFFF" BackgroundColor="#0A8491" CornerRadius="10" HeightRequest="44" FontSize="14" FontAttributes="Bold"
                                Command="{Binding SaveNewItemCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

>>>>>>> 8a3ec5d5508f8052672930d3d067932af7af4192
    </Grid>
</ContentPage>
