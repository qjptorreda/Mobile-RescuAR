<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Prepare"
    x:Class="RescuAR.App.Views.Prepare.ChecklistPage"
    x:Name="thisPage"
    Title="Prepare"
    Shell.NavBarIsVisible="True"
    BackgroundColor="#F2F2F7">

    <ContentPage.BindingContext>
        <vm:ChecklistViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">
            
            <!-- Header Section -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Home/" TextColor="#7F7F7F" FontSize="12" />
                <Label Text="Prepare" TextColor="#000000" FontSize="32" FontAttributes="Bold" />
                <Label Text="Stay ready before disaster strikes." TextColor="#7F7F7F" FontSize="14" />
            </VerticalStackLayout>

            <!-- Disaster Readiness Status Card -->
            <Border BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Disaster Readiness" TextColor="#7F7F7F" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                        <Border Grid.Column="1" BackgroundColor="#E2F0D9" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,4">
                            <Label Text="On Track" TextColor="#385723" FontSize="10" FontAttributes="Bold" />
                        </Border>
                    </Grid>
                    
                    <Label Text="{Binding PercentReady, StringFormat='{0}% ready'}" TextColor="#0A8491" FontSize="28" FontAttributes="Bold" />
                    
                    <ProgressBar Progress="{Binding ProgressValue}" ProgressColor="#0A8491" HeightRequest="8" />
                    
                    <Label Text="{Binding PreparedCountText}" TextColor="#7F7F7F" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Emergency Kit Checklist Section -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Emergency Kit Checklist" TextColor="#000000" FontSize="16" FontAttributes="Bold" />
                
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChecklistItem">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#FFFFFF">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding BindingContext.ToggleItemCommand, Source={x:Reference thisPage}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="12" ColumnSpacing="12" VerticalOptions="Center">
                                    
                                    <!-- Custom Checkbox -->
                                    <Border WidthRequest="24" HeightRequest="24" StrokeShape="RoundRectangle 12" StrokeThickness="1" 
                                            Stroke="#0A8491" BackgroundColor="Transparent">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#0A8491" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Image HorizontalOptions="Center" VerticalOptions="Center" 
                                               IsVisible="{Binding IsCompleted}">
                                            <Image.Source>
                                                <FontImageSource Glyph="✓" Color="White" Size="14" />
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                    
                                    <!-- Title & Description -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <!-- Strikethrough Title and Gray Text if completed -->
                                        <Label Text="{Binding Title}" TextColor="#000000" FontSize="14" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="TextColor" Value="#7F7F7F" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Description}" TextColor="#7F7F7F" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1" />
                                    </VerticalStackLayout>
                                    
                                    <!-- Chevron -->
                                    <Label Grid.Column="2" Text="&gt;" TextColor="#7F7F7F" FontSize="16" VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,4,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- What To Do Section -->
            <VerticalStackLayout Spacing="16">
                <Label Text="What To Do" TextColor="#000000" FontSize="18" FontAttributes="Bold" />
                
                <!-- Category Dropdown Picker -->
                <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E2E2" BackgroundColor="#FFFFFF" Padding="12,4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Picker Title="Category" SelectedIndex="0" TextColor="#000000" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>General Emergency</x:String>
                                    <x:String>Flood Advisory</x:String>
                                    <x:String>Earthquake</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                        <Label Grid.Column="1" Text="▼" TextColor="#7F7F7F" FontSize="10" VerticalOptions="Center" InputTransparent="True" />
                    </Grid>
                </Border>

                <!-- Tab Segmented Control -->
                <Grid ColumnDefinitions="*,*,*" BackgroundColor="#E2E2E2" Padding="2" HeightRequest="40">
                    <Grid.Resources>
                        <Style TargetType="Button">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="#7F7F7F" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontAttributes" Value="Bold" />
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </Grid.Resources>
                    
                    <Border StrokeShape="RoundRectangle 4" StrokeThickness="0" BackgroundColor="Transparent" Grid.Column="0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedTab}" Value="Before">
                                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Button Text="Before" Command="{Binding SelectTabCommand}" CommandParameter="Before">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="Before">
                                    <Setter Property="TextColor" Value="#000000" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Border>

                    <Border StrokeShape="RoundRectangle 4" StrokeThickness="0" BackgroundColor="Transparent" Grid.Column="1">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedTab}" Value="During">
                                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Button Text="During" Command="{Binding SelectTabCommand}" CommandParameter="During">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="During">
                                    <Setter Property="TextColor" Value="#000000" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Border>

                    <Border StrokeShape="RoundRectangle 4" StrokeThickness="0" BackgroundColor="Transparent" Grid.Column="2">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding SelectedTab}" Value="After">
                                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Button Text="After" Command="{Binding SelectTabCommand}" CommandParameter="After">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedTab}" Value="After">
                                    <Setter Property="TextColor" Value="#000000" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Border>
                </Grid>

                <!-- Tab List of Instructions -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#FFFFFF">
                    <VerticalStackLayout Padding="16" Spacing="16" BindableLayout.ItemsSource="{Binding CurrentWhatToDo}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border BackgroundColor="#F2F2F7" StrokeThickness="0" StrokeShape="RoundRectangle 12" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center">
                                        <!-- Simple list number generation could be dynamic, but since it is static 1,2,3,4, let's keep it clean -->
                                        <!-- We can render a bullet point or text -->
                                        <Label Text="•" TextColor="#000000" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding .}" TextColor="#000000" FontSize="13" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Evacuation Center Link -->
                <HorizontalStackLayout HorizontalOptions="Center" Margin="0,8,0,16">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToEvacuationCentersCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="View nearby evacuation centers" TextColor="#0A8491" FontSize="14" FontAttributes="Bold" />
                    <Label Text=" &gt;" TextColor="#0A8491" FontSize="14" FontAttributes="Bold" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>