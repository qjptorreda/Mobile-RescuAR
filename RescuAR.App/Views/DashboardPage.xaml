<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="RescuAR.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Dashboard">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <Label
                Text="RescuAR"
                FontSize="32"
                FontAttributes="Bold" />

            <Border
                Padding="15"
                BackgroundColor="#EEEEEE"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout>

                    <Label
                        Text="Earthquake Alert"
                        FontAttributes="Bold" />

                    <Label
                        Text="Proceed to evacuation immediately." />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
