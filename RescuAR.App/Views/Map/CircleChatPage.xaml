<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RescuAR.App.Views.Map.CircleChatPage"
             Title="Safety Circle Chat"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F2F2F7">
    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="#0F8068" HeightRequest="65" StrokeThickness="0" Padding="16,0">
            <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                <ContentView Grid.Column="0" WidthRequest="40" HeightRequest="40">
                    <ContentView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </ContentView.GestureRecognizers>
                    <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Fill="White" Aspect="Uniform" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                </ContentView>
                <Label Grid.Column="1" Text="Safety Circle Chat" TextColor="White" FontSize="18" FontAttributes="Bold" Margin="10,0,0,0" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Messages List -->
        <CollectionView Grid.Row="1" x:Name="MessagesList" Margin="10" />

        <!-- Input Area -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" BackgroundColor="White">
            <Border Grid.Column="0" Margin="10" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E0E0E0" BackgroundColor="#F5F5F5" Padding="15,0">
                <Entry x:Name="MessageEntry" Placeholder="Type a message..." VerticalOptions="Center" />
            </Border>
            <Border Grid.Column="1" BackgroundColor="#0F8068" WidthRequest="44" HeightRequest="44" Margin="0,0,10,0" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSendClicked" />
                </Border.GestureRecognizers>
                <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" Fill="White" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
