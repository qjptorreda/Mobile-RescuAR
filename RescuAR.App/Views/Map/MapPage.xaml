<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Map"
    x:Class="RescuAR.App.Views.Map.MapPage"
    x:DataType="vm:MapViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F2F2F7">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Custom Header -->
        <Border Grid.Row="0" 
                BackgroundColor="#0F8068" 
                HeightRequest="65" 
                StrokeThickness="0"
                Padding="16,0">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="Evacuation Map" 
                           TextColor="#FFFFFF" 
                           FontSize="18" 
                           FontAttributes="Bold" />
                    <Label Text="Real-time safe zones &amp; active shelters" 
                           TextColor="#B2DFDB" 
                           FontSize="11" />
                </VerticalStackLayout>
                
                <!-- Active Indicator -->
                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                    <Ellipse WidthRequest="8" HeightRequest="8" Fill="#22C55E" />
                    <Label Text="OSM LIVE" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- OSM Leaflet Web Map -->
        <WebView Grid.Row="1" 
                 Source="{Binding MapHtmlSource}" 
                 HorizontalOptions="FillAndExpand" 
                 VerticalOptions="FillAndExpand" />
    </Grid>
</ContentPage>