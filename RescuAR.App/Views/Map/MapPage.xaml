<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RescuAR.App.ViewModels.Map"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
    x:Class="RescuAR.App.Views.Map.MapPage"
    x:DataType="vm:MapViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F2F2F7">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Custom Header -->
        <Border Grid.Row="0" 
                BackgroundColor="#0F8068" 
                HeightRequest="65" 
                StrokeThickness="0"
                Padding="16,0">
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="Evacuation Map" 
                           TextColor="#FFFFFF" 
                           FontSize="18" 
                           FontAttributes="Bold" />
                    <Label Text="Real-time safe zones &amp; active shelters" 
                           TextColor="#B2DFDB" 
                           FontSize="11" />
                </VerticalStackLayout>
                
                <!-- Active Indicator -->
                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                    <Ellipse WidthRequest="8" HeightRequest="8" Fill="#22C55E" />
                    <Label Text="OFFLINE READY" TextColor="#FFFFFF" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- Mapsui Native Map -->
        <mapsui:MapControl x:Name="MapControl" Grid.Row="1" 
                           HorizontalOptions="FillAndExpand" 
                           VerticalOptions="FillAndExpand" />

        <!-- Floating Chat Button for Safety Circle -->
        <Border Grid.Row="1"
                BackgroundColor="#0F8068"
                StrokeThickness="0"
                WidthRequest="56"
                HeightRequest="56"
                Margin="16"
                HorizontalOptions="End"
                VerticalOptions="End"
                Shadow="{Shadow Brush=Black, Offset='0,4', Radius=4, Opacity=0.3}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenChatCommand}" />
            </Border.GestureRecognizers>
            <Path Data="M20 2H4C2.9 2 2 2.9 2 4V22L6 18H20C21.1 18 22 17.1 22 16V4C22 2.9 21.1 2 20 2Z" 
                  Fill="White" 
                  Aspect="Uniform" 
                  WidthRequest="24" 
                  HeightRequest="24" 
                  HorizontalOptions="Center" 
                  VerticalOptions="Center" />
        </Border>
                 
        <!-- Subtle shadow/line for TabBar -->
        <BoxView Grid.RowSpan="2" VerticalOptions="End" HeightRequest="1" BackgroundColor="#D1D1D6" />
    </Grid>
</ContentPage>