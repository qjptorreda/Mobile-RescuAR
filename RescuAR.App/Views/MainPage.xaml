<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="RescuAR.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout
        Padding="24"
        Spacing="16">

        <Label
            Text="Select Safe Zone"
            FontSize="24" />

        <Picker
            x:Name="EvacuationCenterPicker"
            Title="Choose Evacuation Center"
            ItemDisplayBinding="{Binding Name}" />

        <Button
            Text="Launch AR Navigation"
            Clicked="LaunchUnityClicked" />

    </VerticalStackLayout>

</ContentPage>
    